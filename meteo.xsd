<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="meteo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="mesure" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ville" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="nom" use="required">
                    <xs:simpleType>
                      <xs:restriction base="xs:token">
                        <xs:minLength value="1"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="temperature" type="xs:decimal" use="required"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="date" type="xs:date" use="required"/>
          </xs:complexType>
          <xs:unique name="villeUniqueParMesure">
            <xs:selector xpath="ville"/>
            <xs:field xpath="@nom"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="dateUnique">
      <xs:selector xpath="mesure"/>
      <xs:field xpath="@date"/>
    </xs:unique>
  </xs:element>
</xs:schema>
